# Required: long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Comma separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173
# Optional (defaults to SQLite file phishing.db)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/phishing_db
# Optional external threat intel - only queried when set
VT_API_KEY=
URLHAUS_AUTH_KEY=
